{
  "datasets": [
    {
      "name": "253d89ad",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "select *\n",
        "from dim_customers;\n",
        "\n",
        "-- Total orders over time\n",
        "select order_date,\n",
        "       count(*) as total_orders\n",
        "from fact_sales\n",
        "group by order_date\n",
        "order by order_date;\n",
        "\n",
        "-- total sales over month\n",
        "select date_trunc('month', order_date) as orderdate,\n",
        "       sum(sales_amount) as total_sales\n",
        "from fact_sales\n",
        "group by orderdate\n",
        "order by orderdate;"
      ]
    },
    {
      "name": "84c1df49",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "-- How much total sales are there for each category\n",
        "SELECT\n",
        "    SUM(sales_amount) AS Sales,\n",
        "    p.category AS category\n",
        "FROM fact_sales f\n",
        "LEFT JOIN dim_products p\n",
        "    ON f.product_key = p.product_key\n",
        "GROUP BY p.category\n",
        "ORDER BY Sales DESC;"
      ]
    }
  ],
